DB_URL=jdbc:mysql://localhost:3306/ai_media_center_dev
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
# Base64 of at least 32 cryptographically random bytes. Never commit the real value.
JWT_SECRET=replace_with_random_base64_secret
# Base64 of exactly 32 cryptographically random bytes (AES-256-GCM).
# Keep the same key across restarts; changing it makes existing source configurations unreadable.
# Missing/invalid key permits authentication and empty source lists, but blocks create/nonempty reads.
MEDIA_SOURCE_ENCRYPTION_KEY=replace_with_random_base64_key
# Total connection-test deadline, including headers and response body; accepted range 100-15000 ms.
MEDIA_SOURCE_CONNECTION_TIMEOUT_MS=8000
